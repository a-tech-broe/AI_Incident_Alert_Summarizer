# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
.terraformrc
terraform.rc

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars may carry account IDs, endpoints or credentials. terraform.tfvars is
# tracked deliberately: it holds only non-secret defaults, and every real
# credential lives in Secrets Manager.
*.tfvars
*.tfvars.json
!terraform/terraform.tfvars

# Saved plans — the deploy pipeline passes these between jobs as artifacts.
tfplan
*.tfplan
plan.txt
plan-full.txt

# Generated by the Lambda module's bootstrap package.
**/.terraform-bootstrap.zip

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
build/
dist/
deployment-package.zip

# ---------------------------------------------------------------------------
# Local and editor
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
.DS_Store
.idea/
.vscode/
